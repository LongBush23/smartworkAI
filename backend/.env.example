MONGO_URI=mongodb+srv://<username>:<password>@cluster0.../smartwork
DB_NAME=smartwork
SECRET_KEY=your_secret_key_here
# Trợ lý hội thoại — chỗ DUY NHẤT hệ thống gọi ra dịch vụ bên ngoài.
# Bỏ trống thì trợ lý tự lui về máy tra cứu tại chỗ, hệ thống vẫn chạy bình thường.
GEMINI_API_KEY=your_gemini_key_here
# Không ghim phiên bản cố định: gemini-2.5-* đã bị ngừng cấp cho khoá mới (404).
# Bản flash-lite có hạn mức miễn phí rộng hơn hẳn flash thường (20 lượt/ngày).
GEMINI_MODEL=gemini-flash-lite-latest
