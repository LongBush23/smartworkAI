{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kpi-backend",
      "runtimeExecutable": "backend/venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "backend.main:app",
        "--port",
        "8000"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "kpi-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "cwd": "frontend"
    }
  ]
}
