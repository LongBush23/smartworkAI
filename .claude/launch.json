{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "kpi-backend",
      "runtimeExecutable": "backend/venv/bin/uvicorn",
      "runtimeArgs": ["backend.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "kpi-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5199", "--strictPort"],
      "port": 5199,
      "cwd": "frontend"
    }
  ]
}
